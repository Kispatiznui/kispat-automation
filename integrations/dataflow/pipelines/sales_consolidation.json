{
  "contract_version": "dataflow/v1",
  "name": "sales-consolidation",
  "version": "1.0.0",
  "description": "Consolida ventas de varias áreas (CSV y xlsx), valida y separa incidencias.",
  "inputs": {
    "files": ["ventas_*.csv", "ventas_*.xlsx"],
    "on_file_error": "fail",
    "max_file_mb": 20
  },
  "steps": [
    {"op": "normalize_headers"},
    {"op": "trim_text"},
    {"op": "require_fields", "fields": ["id_pedido", "total"], "on_missing": "reject"},
    {"op": "require_fields", "fields": ["cliente", "fecha_venta"], "on_missing": "review"},
    {"op": "normalize_dates", "columns": ["fecha_venta"], "formats": ["%Y-%m-%d", "%d/%m/%Y"], "on_error": "review"},
    {"op": "cast_types", "types": {"cantidad": "int", "total": "decimal"}, "on_error": "reject"},
    {"op": "dedupe", "keys": ["id_pedido"], "on_duplicate": "review"}
  ],
  "outputs": {
    "formats": ["csv", "xlsx"],
    "summary": {"group_by": ["region"], "sum": ["cantidad", "total"]}
  },
  "policy": {"max_rejected_ratio": 0.5}
}
