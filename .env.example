# --- control (/etc/kispat/control.env) ---
DATABASE_URL=postgresql+psycopg://kispat:CAMBIAME@127.0.0.1:5432/kispat
HOST=0.0.0.0
PORT=8000
CLIENT_TOKEN=genera-con-openssl-rand-hex-32
REGISTRATION_TOKEN=genera-con-openssl-rand-hex-32
AUTOMATIONS_DIR=/var/lib/kispat/automations
AUDIT_PATH=/var/lib/kispat/audit.jsonl
LOG_LEVEL=INFO

# --- agent (/etc/kispat/agent.env) ---
CTRL_URL=http://127.0.0.1:8000
NODE_ID=mi-nodo
NODE_TOKEN=genera-con-openssl-rand-hex-32
REGISTRATION_TOKEN=el-mismo-que-en-control
WORK_DIR=/var/lib/kispat/work

# --- tests ---
TEST_DATABASE_URL=postgresql+psycopg://kispat_test:kispat_test@127.0.0.1:5432/kispat_test
